+  void BlePeripheralPlugin::Publisher_StatusChanged(BluetoothLEAdvertisementPublisher const &sender, BluetoothLEAdvertisementPublisherStatusChangedEventArgs const &args)
+  {
+    auto status = args.Status();
+    auto error = args.Error();
+    std::string statusStr = PublisherStatusToString(status);
+    std::cout << "Publisher StatusChanged: " << statusStr << ", Error " << (int)error << std::endl;
+    if (status == BluetoothLEAdvertisementPublisherStatus::Aborted) {
+      publisherStarted = false;
+      std::string err = "Publisher aborted";
+      if (error != BluetoothError::Success) err = ParseBluetoothError(error);
+      uiThreadHandler_.Post([err] { bleCallback->OnAdvertisingStatusUpdate(false, &err, SuccessCallback, ErrorCallback); });
+    } else if (status == BluetoothLEAdvertisementPublisherStatus::Started) {
+      publisherStarted = true;
+      uiThreadHandler_.Post([] { bleCallback->OnAdvertisingStatusUpdate(true, nullptr, SuccessCallback, ErrorCallback); });
+    } else if (status == BluetoothLEAdvertisementPublisherStatus::Stopped) {
+      publisherStarted = false;
+      uiThreadHandler_.Post([] { bleCallback->OnAdvertisingStatusUpdate(false, nullptr, SuccessCallback, ErrorCallback); });
+    }
+  }
